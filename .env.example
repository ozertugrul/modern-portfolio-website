# SMTP Email Configuration
# Configure these settings to enable email replies from the admin panel

# SMTP server hostname
# Examples:
#   Gmail: smtp.gmail.com
#   Outlook: smtp-mail.outlook.com  
#   Your domain: mail.ertugrulozer.com.tr
SMTP_HOST=smtp.gmail.com

# SMTP port (usually 587 for TLS or 465 for SSL)
SMTP_PORT=587

# Sender email address (this will appear as "From" in sent emails)
SMTP_USER=info@ertugrulozer.com.tr

# Email password or app-specific password
# For Gmail: Use an App Password (not your regular password)
# For other providers: Use your email password or app-specific password
SMTP_PASSWORD=your_password_here
