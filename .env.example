# SMTP Email Configuration
# Configure these settings to enable email replies from the admin panel

# SMTP server hostname
# Examples:
#   Gmail: smtp.gmail.com
#   Gmail for custom domain: smtp.gmail.com
#   Yandex: smtp.yandex.com
#   Zoho: smtp.zoho.com
#   Outlook: smtp-mail.outlook.com  
SMTP_HOST=smtp.gmail.com

# SMTP port (usually 587 for TLS)
SMTP_PORT=587

# Sender email address (this will appear as "From" in sent emails)
# You can use your custom domain email if configured with the SMTP provider
SMTP_USER=info@ertugrulozer.com.tr

# Email password or app-specific password
# For Gmail with custom domain:
#   1. Go to Google Admin Console
#   2. Add your custom domain
#   3. Create user info@ertugrulozer.com.tr
#   4. Generate App Password: https://myaccount.google.com/apppasswords
# For Yandex Connect (free for custom domains):
#   1. Go to https://connect.yandex.com
#   2. Add your domain and verify
#   3. Create mailbox info@ertugrulozer.com.tr
#   4. Use the mailbox password
# For Zoho Mail (free for 5 users):
#   1. Go to https://www.zoho.com/mail/
#   2. Add your domain
#   3. Create mailbox info@ertugrulozer.com.tr
#   4. Generate App Password in account settings
SMTP_PASSWORD=your_app_password_here

# Public URL of your website (used for file attachments in emails)
# Examples:
#   Production: https://yourdomain.com
#   Development: http://localhost:3000
#   Cloudflare Tunnel: https://your-tunnel.trycloudflare.com
BASE_URL=https://yourdomain.com

# Session/Admin security (required)
# SESSION_SECRET must be at least 64 characters
SESSION_SECRET=replace_with_min_64_char_random_secret________________________________

# First startup bootstrap (use one of these)
ADMIN_PASSWORD=replace_with_strong_password
# ADMIN_PASSWORD_HASH=$2b$12$...

# Database
POSTGRES_PASSWORD=replace_with_strong_db_password
DATABASE_URL=postgresql://portfolio_user:${POSTGRES_PASSWORD}@postgres:5432/portfolio_db

# Beszel monitoring
BESZEL_APP_URL=http://localhost:8090
BESZEL_AGENT_HUB_URL=http://127.0.0.1:8090
BESZEL_AGENT_LISTEN=45876
BESZEL_AGENT_TOKEN=replace_with_universal_or_system_token
BESZEL_AGENT_KEY=replace_with_public_key_from_hub
BESZEL_AGENT_DISABLE_SSH=true
BESZEL_AGENT_DOCKER_HOST=
