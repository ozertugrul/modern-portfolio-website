// Helper: Get admin password hash from Redis or default
async fn get_admin_password_hash(state: &AppState) -> Result<String, StatusCode> {
    let hash_row = sqlx::query!(
        r#"
        SELECT password_hash
        FROM admin_users
        WHERE username = 'admin'
        LIMIT 1
        "#
    )
    .fetch_optional(&state.db_pool)
    .await
    .map_err(|e| {
        eprintln!("Database error in get_admin_password_hash: {}", e);
        StatusCode::INTERNAL_SERVER_ERROR
    })?;
    
    if let Some(row) = hash_row {
        Ok(row.password_hash)
    } else {
        // No admin user yet, return default hash
        // The default admin user should have been created in migration
        Ok(DEFAULT_ADMIN_PASSWORD_HASH.to_string())
    }
}

