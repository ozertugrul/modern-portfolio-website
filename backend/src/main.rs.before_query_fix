// List backups - filesystem based
async fn admin_list_backups(
    session: ReadableSession,
) -> Result<Json<Vec<BackupInfo>>, StatusCode> {
    if !is_admin(session).await {
        return Err(StatusCode::UNAUTHORIZED);
    }

    use std::fs;
    use std::path::Path;

    let backup_dir = "/data/backups";
    
    if let Err(_) = fs::create_dir_all(backup_dir) {
        return Ok(Json(vec![]));
    }

    let mut backups = vec![];
    
    if let Ok(entries) = fs::read_dir(backup_dir) {
        for entry in entries.flatten() {
            if let Ok(metadata) = entry.metadata() {
                if metadata.is_file() {
                    if let Some(filename) = entry.file_name().to_str() {
                        if filename.ends_with(".sql") || filename.ends_with(".json") {
                            let created_at = metadata.modified()
                                .ok()
                                .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
                                .map(|d| chrono::DateTime::from_timestamp(d.as_secs() as i64, 0))
                                .flatten()
                                .map(|dt| dt.to_rfc3339())
                                .unwrap_or_else(|| chrono::Utc::now().to_rfc3339());

                            backups.push(BackupInfo {
                                filename: filename.to_string(),
                                size: metadata.len(),
                                created_at,
                            });
                        }
                    }
                }
            }
        }
    }

    backups.sort_by(|a, b| b.created_at.cmp(&a.created_at));

    Ok(Json(backups))
}
// Create backup - SQL based (without external tools)
async fn admin_create_backup(
    session: ReadableSession,
    Extension(state): Extension<AppState>,
) -> Result<Json<serde_json::Value>, StatusCode> {
    if !is_admin(session).await {
        return Err(StatusCode::UNAUTHORIZED);
    }

    use std::fs;
    use std::path::Path;

    let backup_dir = "/data/backups";
    fs::create_dir_all(backup_dir).map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)?;

    let timestamp = chrono::Utc::now().format("%Y%m%d_%H%M%S");
    let backup_filename = format!("backup_{}.sql", timestamp);
    let backup_path = Path::new(backup_dir).join(&backup_filename);

    // Create SQL backup with all data
    let mut backup_sql = String::from("-- Portfolio Database Backup\n");
    backup_sql.push_str(&format!("-- Generated: {}\n\n", chrono::Utc::now().to_rfc3339()));
    
    // Backup hero section
    let heroes = sqlx::query("SELECT * FROM hero_section")
        .fetch_all(&state.db_pool)
        .await
        .map_err(|e| {
            eprintln!("Backup error (hero): {}", e);
            StatusCode::INTERNAL_SERVER_ERROR
        })?;
    
    if !heroes.is_empty() {
        backup_sql.push_str("-- Hero Section\n");
        backup_sql.push_str("TRUNCATE hero_section CASCADE;\n");
        for row in heroes {
            let greeting_tr: String = row.get("greeting_tr").unwrap_or_default();
            let greeting_en: String = row.get("greeting_en").unwrap_or_default();
            let name: String = row.get("name").unwrap_or_default();
            let title_tr: String = row.get("title_tr").unwrap_or_default();
            let title_en: String = row.get("title_en").unwrap_or_default();
            
            backup_sql.push_str(&format!(
                "INSERT INTO hero_section (greeting_tr, greeting_en, name, title_tr, title_en) VALUES ('{}', '{}', '{}', '{}', '{}');\n",
                greeting_tr.replace("'", "''"),
                greeting_en.replace("'", "''"),
                name.replace("'", "''"),
                title_tr.replace("'", "''"),
                title_en.replace("'", "''")
            ));
        }
        backup_sql.push_str("\n");
    }
    
    // Backup portfolio items
    let portfolio_items = sqlx::query("SELECT * FROM portfolio_items ORDER BY display_order")
        .fetch_all(&state.db_pool)
        .await
        .map_err(|e| {
            eprintln!("Backup error (portfolio): {}", e);
            StatusCode::INTERNAL_SERVER_ERROR
        })?;
    
    if !portfolio_items.is_empty() {
        backup_sql.push_str("-- Portfolio Items\n");
        backup_sql.push_str("TRUNCATE portfolio_items CASCADE;\n");
        for row in portfolio_items {
            let id: uuid::Uuid = row.get("id").unwrap_or_else(|_| uuid::Uuid::new_v4());
            let title: String = row.get("title").unwrap_or_default();
            let description: String = row.get("description").unwrap_or_default();
            let image_url: String = row.get("image_url").unwrap_or_default();
            let project_url: Option<String> = row.get("project_url").ok().flatten();
            let technologies: Vec<String> = row.get("technologies").unwrap_or_default();
            let display_order: i32 = row.get("display_order").unwrap_or(0);
            
            backup_sql.push_str(&format!(
                "INSERT INTO portfolio_items (id, title, description, image_url, project_url, technologies, display_order) VALUES ('{}', '{}', '{}', '{}', {}, ARRAY[{}], {});\n",
                id,
                title.replace("'", "''"),
                description.replace("'", "''"),
                image_url.replace("'", "''"),
                project_url.map(|u| format!("'{}'", u.replace("'", "''"))).unwrap_or_else(|| "NULL".to_string()),
                technologies.iter().map(|t| format!("'{}'", t.replace("'", "''"))).collect::<Vec<_>>().join(", "),
                display_order
            ));
        }
        backup_sql.push_str("\n");
    }

    // Backup about info
    let about_rows = sqlx::query("SELECT * FROM about_info")
        .fetch_all(&state.db_pool)
        .await
        .map_err(|e| {
            eprintln!("Backup error (about): {}", e);
            StatusCode::INTERNAL_SERVER_ERROR
        })?;
    
    if !about_rows.is_empty() {
        backup_sql.push_str("-- About Info\n");
        backup_sql.push_str("TRUNCATE about_info CASCADE;\n");
        for row in about_rows {
            let title_tr: String = row.get("title_tr").unwrap_or_default();
            let title_en: String = row.get("title_en").unwrap_or_default();
            let description_tr: String = row.get("description_tr").unwrap_or_default();
            let description_en: String = row.get("description_en").unwrap_or_default();
            let image_url: String = row.get("image_url").unwrap_or_default();
            let cv_url: Option<String> = row.get("cv_url").ok().flatten();
            
            backup_sql.push_str(&format!(
                "INSERT INTO about_info (title_tr, title_en, description_tr, description_en, image_url, cv_url) VALUES ('{}', '{}', '{}', '{}', '{}', {});\n",
                title_tr.replace("'", "''"),
                title_en.replace("'", "''"),
                description_tr.replace("'", "''"),
                description_en.replace("'", "''"),
                image_url.replace("'", "''"),
                cv_url.map(|u| format!("'{}'", u.replace("'", "''"))).unwrap_or_else(|| "NULL".to_string())
            ));
        }
        backup_sql.push_str("\n");
    }

    // Write backup file
    fs::write(&backup_path, backup_sql.as_bytes())
        .map_err(|e| {
            eprintln!("Failed to write backup: {}", e);
            StatusCode::INTERNAL_SERVER_ERROR
        })?;

    let file_size = fs::metadata(&backup_path)
        .map(|m| m.len() as i64)
        .unwrap_or(0);

    tracing::info!("✅ Backup created: {} ({} bytes)", backup_filename, file_size);

    Ok(Json(serde_json::json!({
        "success": true,
        "filename": backup_filename,
        "size": file_size,
        "message": "Yedek başarıyla oluşturuldu"
    })))
}

