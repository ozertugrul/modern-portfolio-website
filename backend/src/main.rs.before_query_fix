async fn contact(
    Extension(state): Extension<AppState>,
    Json(payload): Json<serde_json::Value>,
) -> Result<Json<serde_json::Value>, StatusCode> {
    let name = payload.get("name").and_then(|v| v.as_str()).ok_or(StatusCode::BAD_REQUEST)?;
    let email = payload.get("email").and_then(|v| v.as_str()).ok_or(StatusCode::BAD_REQUEST)?;
    let message = payload.get("message").and_then(|v| v.as_str()).ok_or(StatusCode::BAD_REQUEST)?;
    
    // Insert contact message into PostgreSQL
    sqlx::query!(
        r#"
        INSERT INTO contact_messages (name, email, message, is_read)
        VALUES ($1, $2, $3, false)
        "#,
        name,
        email,
        message
    )
    .execute(&state.db_pool)
    .await
    .map_err(|e| {
        eprintln!("Database error in contact: {}", e);
        StatusCode::INTERNAL_SERVER_ERROR
    })?;
    
    Ok(Json(serde_json::json!({
        "success": true,
        "message": "Mesajınız başarıyla gönderildi!"
    })))
}

async fn health_check() -> Json<HealthCheck> {
    use std::time::{SystemTime, UNIX_EPOCH};
    let timestamp = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap()
        .as_secs()
        .to_string();

    Json(HealthCheck {
        status: "healthy".to_string(),
        service: "backend".to_string(),
        timestamp,
    })
}

async fn get_translations(Extension(state): Extension<AppState>) -> Result<Json<Translations>, StatusCode> {
    // PostgreSQL'den çevirileri al
    let translations = sqlx::query!(
        r#"
        SELECT 
            locale,
            translations as "translations!: sqlx::types::Json<serde_json::Value>"
        FROM translations
        "#
    )
    .fetch_all(&state.db_pool)
    .await
    .map_err(|e| {
        eprintln!("Database error in get_translations: {}", e);
        StatusCode::INTERNAL_SERVER_ERROR
    })?;
    
    let mut tr_data = serde_json::json!({});
    let mut en_data = serde_json::json!({});
    
    for row in translations {
        if row.locale == "tr" {
            tr_data = row.translations.0;
        } else if row.locale == "en" {
            en_data = row.translations.0;
        }
    }
    
    Ok(Json(Translations {
        tr: tr_data,
        en: en_data,
    }))
}

